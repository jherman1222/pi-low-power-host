# Optional Pi udev rules for Victron VE.Direct-USB adapters.
# Install on Pi:
#   sudo cp udev/99-victron-vedirect.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Prefer /dev/serial/by-id/* in .env over these symlinks when possible.
# Confirm ATTRS with: udevadm info --name=/dev/ttyUSB0 --attribute-walk

SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", SYMLINK+="victron-vedirect-%n", MODE="0660", GROUP="dialout", TAG+="uaccess"
