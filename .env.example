# Copy to .env on the Pi and: chmod 600 .env
# Never commit .env.

TZ=America/Los_Angeles
DATA_ROOT=/srv/pi-data

# Mosquitto + HA (scripts/init-mqtt.sh creates passwd from these)
MQTT_USER=pi
MQTT_PASSWORD=replace-with-a-long-random-password
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Persistent VE.Direct USB paths from: ls -l /dev/serial/by-id/
# One genuine isolated Victron cable (ASS030530000) per device.
# Orion-Tr Smart has NO VE.Direct — do not invent a third path.
VE_DIRECT_SHUNT=/dev/serial/by-id/usb-VictronEnergy_BV_VE_Direct_cable_REPLACE_SHUNT-if00-port0
VE_DIRECT_MPPT=/dev/serial/by-id/usb-VictronEnergy_BV_VE_Direct_cable_REPLACE_MPPT-if00-port0

# Discord bot (MetalDetected) — Mac source: /Users/jh/metal-detected-bot
# After rsync to Pi, point this at the unpacked tree:
DISCORD_BOT_SOURCE=/srv/pi-data/apps/metal-detected-bot

# Bot secrets live in ${DISCORD_BOT_SOURCE}/.env on the Pi (not here):
#   DISCORD_TOKEN=
#   GEMINI_API_KEY=
# Optional model overrides used by index.js:
#   GEMINI_CHAT_MODEL=gemini-1.5-flash
#   GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
